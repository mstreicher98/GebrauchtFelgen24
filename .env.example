# ---------------------------------------------------------------
# GebrauchtFelgen24 – Umgebungsvariablen
# Für Portainer: diese Werte im Stack unter "Environment variables" setzen.
# ---------------------------------------------------------------

# Öffentliche Adresse der Seite (ohne Schrägstrich am Ende)
APP_URL=https://gebrauchtfelgen24.at

# Datenbank (wird im docker-compose automatisch gesetzt)
POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort
DATABASE_URL=postgres://felgen:${POSTGRES_PASSWORD}@db:5432/felgen

# Geheimer Schlüssel für Sessions – mind. 32 Zeichen, z. B.: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Diese E-Mail-Adresse bekommt automatisch Admin-Rechte
ADMIN_EMAIL=office@gebrauchtfelgen24.at

# E-Mail-Versand (SMTP). Ohne SMTP_HOST werden Mails nur ins Log geschrieben.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GebrauchtFelgen24 <noreply@gebrauchtfelgen24.at>"

# Login mit Google (optional) – https://console.cloud.google.com/apis/credentials
# Redirect-URI: https://gebrauchtfelgen24.at/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login mit Apple (optional) – https://developer.apple.com/account/resources/identifiers
# Return-URL: https://gebrauchtfelgen24.at/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Web-Push (optional) – werden sonst automatisch erzeugt und in der DB gespeichert
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:office@gebrauchtfelgen24.at

# Laufzeit von Inseraten in Tagen
LISTING_LIFETIME_DAYS=60

# Demo-Daten (Testnutzer + Testinserate) beim ersten Start anlegen – in Produktion auf false!
SEED_DEMO=false
